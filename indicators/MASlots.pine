s20Weekly = input.bool(title='Weekly', defval=false, inline='S20b', group='Slot 20', display=display.data_window)
s20Monthly = input.bool(title='Monthly', defval=false, inline='S20b', group='Slot 20', display=display.data_window)

//***************************************************************************************
// Inputs — Cross-Timeframe Overlays
// These intentionally DO fetch a different timeframe than your chart (e.g. a
// Weekly MA shown on a Daily chart) via request.security(). Because the source
// bar updates less often than your chart, the line will hold flat and then step
// to a new value — that's expected for this feature, not a bug. Historical bars
// also show the completed source-timeframe value early, which can differ from
// what a live chart showed in real time (repainting) — a known trade-off of
// this technique, not specific to any single MA type.
//***************************************************************************************

o1Len = input.int(title='Period', minval=1, maxval=5000, defval=10, inline='O1a', group='Overlay 1', display=display.data_window)
o1Type = input.string(title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], defval='SMA', inline='O1a', group='Overlay 1', display=display.data_window)
o1Src = input.source(title='', defval=close, inline='O1a', group='Overlay 1', display=display.data_window)
o1Col = input.color(title='', defval=color.olive, inline='O1a', group='Overlay 1', display=display.data_window)
o1Width = input.int(title='Width', minval=1, maxval=4, defval=1, inline='O1a', group='Overlay 1', display=display.data_window)
o1SrcTF = input.string(title='Source TF', options=['D', 'W', 'M'], defval='W', inline='O1b', group='Overlay 1', display=display.data_window)
o1DispIntra = input.bool(title='Intraday', defval=false, inline='O1b', group='Overlay 1', display=display.data_window)
o1DispDaily = input.bool(title='Daily', defval=true, inline='O1b', group='Overlay 1', display=display.data_window)
o1DispWeekly = input.bool(title='Weekly', defval=false, inline='O1b', group='Overlay 1', display=display.data_window)
o1DispMonthly = input.bool(title='Monthly', defval=false, inline='O1b', group='Overlay 1', display=display.data_window)

