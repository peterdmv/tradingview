s3Val = f_ma(s3Src, s3Len, s3Type)
s3Show = (timeframe.isintraday and s3Intra) or (timeframe.isdaily and s3Daily) or (timeframe.isweekly and s3Weekly) or (timeframe.ismonthly and s3Monthly)
s3Plot = plot(s3Show ? s3Val : na, title='Slot 3', color=s3Col, linewidth=s3Width)

s4Val = f_ma(s4Src, s4Len, s4Type)
s4Show = (timeframe.isintraday and s4Intra) or (timeframe.isdaily and s4Daily) or (timeframe.isweekly and s4Weekly) or (timeframe.ismonthly and s4Monthly)
s4Plot = plot(s4Show ? s4Val : na, title='Slot 4', color=s4Col, linewidth=s4Width)

s5Val = f_ma(s5Src, s5Len, s5Type)
