cloudDailyValidA = f_pickBool(cloudDailyMA1, s1Daily, s2Daily, s3Daily, s4Daily, s5Daily, s6Daily, s7Daily, s8Daily, s9Daily, s10Daily, s11Daily, s12Daily, s13Daily, s14Daily, s15Daily, s16Daily, s17Daily, s18Daily, s19Daily, s20Daily)
cloudDailyValidB = f_pickBool(cloudDailyMA2, s1Daily, s2Daily, s3Daily, s4Daily, s5Daily, s6Daily, s7Daily, s8Daily, s9Daily, s10Daily, s11Daily, s12Daily, s13Daily, s14Daily, s15Daily, s16Daily, s17Daily, s18Daily, s19Daily, s20Daily)
