//***************************************************************************************
// Inputs — Clouds (one per timeframe class)
// Pick two Slot numbers that are BOTH enabled for this class. If they aren't,
// the cloud won't draw and a warning label explains why on the chart.
//***************************************************************************************

cloudIntradayShow = input.bool(title='Show Cloud', defval=false, inline='CIntradaya', group='Cloud - Intraday', display=display.data_window)
cloudIntradayUp = input.color(title='Up', defval=color.new(color.green, 90), inline='CIntradaya', group='Cloud - Intraday', display=display.data_window)
cloudIntradayDown = input.color(title='Down', defval=color.new(color.red, 90), inline='CIntradaya', group='Cloud - Intraday', display=display.data_window)
cloudIntradayMA1 = input.int(title='Between Slot #', defval=1, minval=1, maxval=20, inline='CIntradayb', group='Cloud - Intraday', display=display.data_window)
cloudIntradayMA2 = input.int(title='and #', defval=2, minval=1, maxval=20, inline='CIntradayb', group='Cloud - Intraday', display=display.data_window)

cloudDailyShow = input.bool(title='Show Cloud', defval=true, inline='CDailya', group='Cloud - Daily', display=display.data_window)
cloudDailyUp = input.color(title='Up', defval=color.new(color.green, 90), inline='CDailya', group='Cloud - Daily', display=display.data_window)
cloudDailyDown = input.color(title='Down', defval=color.new(color.red, 90), inline='CDailya', group='Cloud - Daily', display=display.data_window)
cloudDailyMA1 = input.int(title='Between Slot #', defval=4, minval=1, maxval=20, inline='CDailyb', group='Cloud - Daily', display=display.data_window)
cloudDailyMA2 = input.int(title='and #', defval=9, minval=1, maxval=20, inline='CDailyb', group='Cloud - Daily', display=display.data_window)

cloudWeeklyShow = input.bool(title='Show Cloud', defval=false, inline='CWeeklya', group='Cloud - Weekly', display=display.data_window)
cloudWeeklyUp = input.color(title='Up', defval=color.new(color.green, 90), inline='CWeeklya', group='Cloud - Weekly', display=display.data_window)
cloudWeeklyDown = input.color(title='Down', defval=color.new(color.red, 90), inline='CWeeklya', group='Cloud - Weekly', display=display.data_window)
