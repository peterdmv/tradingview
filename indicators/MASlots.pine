cloudWeeklyMA2 = input.int(title='and #', defval=2, minval=1, maxval=20, inline='CWeeklyb', group='Cloud - Weekly', display=display.data_window)

cloudMonthlyShow = input.bool(title='Show Cloud', defval=false, inline='CMonthlya', group='Cloud - Monthly', display=display.data_window)
