cloudIntradayValid = cloudIntradayValidA and cloudIntradayValidB
cloudIntradayActive = cloudIntradayShow and cloudIntradayValid and timeframe.isintraday
cloudIntradayFillColor = color.rgb(0, 0, 0, 100)
if cloudIntradayActive
    cloudIntradayFillColor := cloudIntradayValA < cloudIntradayValB ? cloudIntradayDown : cloudIntradayUp
cloudIntradayPlotA = plot(cloudIntradayActive ? cloudIntradayValA : na, title='Intraday Cloud Boundary A', display=display.none)
cloudIntradayPlotB = plot(cloudIntradayActive ? cloudIntradayValB : na, title='Intraday Cloud Boundary B', display=display.none)
fill(cloudIntradayPlotA, cloudIntradayPlotB, color=cloudIntradayFillColor)
cloudIntradayInvalid = cloudIntradayShow and timeframe.isintraday and not cloudIntradayValid

// Daily cloud
cloudDailyValA = f_pick(cloudDailyMA1, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
