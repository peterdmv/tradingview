s15Show = (timeframe.isintraday and s15Intra) or (timeframe.isdaily and s15Daily) or (timeframe.isweekly and s15Weekly) or (timeframe.ismonthly and s15Monthly)
s15Plot = plot(s15Show ? s15Val : na, title='Slot 15', color=s15Col, linewidth=s15Width)

