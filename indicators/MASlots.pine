//***************************************************************************************
// Calculate & plot — Native Slots
//***************************************************************************************

s1Val = f_ma(s1Src, s1Len, s1Type)
s1Show = (timeframe.isintraday and s1Intra) or (timeframe.isdaily and s1Daily) or (timeframe.isweekly and s1Weekly) or (timeframe.ismonthly and s1Monthly)
s1Plot = plot(s1Show ? s1Val : na, title='Slot 1', color=s1Col, linewidth=s1Width)

s2Val = f_ma(s2Src, s2Len, s2Type)
s2Show = (timeframe.isintraday and s2Intra) or (timeframe.isdaily and s2Daily) or (timeframe.isweekly and s2Weekly) or (timeframe.ismonthly and s2Monthly)
