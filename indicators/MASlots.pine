// Monthly cloud
cloudMonthlyValA = f_pick(cloudMonthlyMA1, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudMonthlyValB = f_pick(cloudMonthlyMA2, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudMonthlyValidA = f_pickBool(cloudMonthlyMA1, s1Monthly, s2Monthly, s3Monthly, s4Monthly, s5Monthly, s6Monthly, s7Monthly, s8Monthly, s9Monthly, s10Monthly, s11Monthly, s12Monthly, s13Monthly, s14Monthly, s15Monthly, s16Monthly, s17Monthly, s18Monthly, s19Monthly, s20Monthly)
cloudMonthlyValidB = f_pickBool(cloudMonthlyMA2, s1Monthly, s2Monthly, s3Monthly, s4Monthly, s5Monthly, s6Monthly, s7Monthly, s8Monthly, s9Monthly, s10Monthly, s11Monthly, s12Monthly, s13Monthly, s14Monthly, s15Monthly, s16Monthly, s17Monthly, s18Monthly, s19Monthly, s20Monthly)
