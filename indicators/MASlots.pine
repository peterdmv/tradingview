cloudDailyActive = cloudDailyShow and cloudDailyValid and timeframe.isdaily
cloudDailyFillColor = color.rgb(0, 0, 0, 100)
if cloudDailyActive
    cloudDailyFillColor := cloudDailyValA < cloudDailyValB ? cloudDailyDown : cloudDailyUp
cloudDailyPlotA = plot(cloudDailyActive ? cloudDailyValA : na, title='Daily Cloud Boundary A', display=display.none)
cloudDailyPlotB = plot(cloudDailyActive ? cloudDailyValB : na, title='Daily Cloud Boundary B', display=display.none)
fill(cloudDailyPlotA, cloudDailyPlotB, color=cloudDailyFillColor)
cloudDailyInvalid = cloudDailyShow and timeframe.isdaily and not cloudDailyValid

// Weekly cloud
cloudWeeklyValA = f_pick(cloudWeeklyMA1, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudWeeklyValB = f_pick(cloudWeeklyMA2, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudWeeklyValidA = f_pickBool(cloudWeeklyMA1, s1Weekly, s2Weekly, s3Weekly, s4Weekly, s5Weekly, s6Weekly, s7Weekly, s8Weekly, s9Weekly, s10Weekly, s11Weekly, s12Weekly, s13Weekly, s14Weekly, s15Weekly, s16Weekly, s17Weekly, s18Weekly, s19Weekly, s20Weekly)
cloudWeeklyValidB = f_pickBool(cloudWeeklyMA2, s1Weekly, s2Weekly, s3Weekly, s4Weekly, s5Weekly, s6Weekly, s7Weekly, s8Weekly, s9Weekly, s10Weekly, s11Weekly, s12Weekly, s13Weekly, s14Weekly, s15Weekly, s16Weekly, s17Weekly, s18Weekly, s19Weekly, s20Weekly)
cloudWeeklyValid = cloudWeeklyValidA and cloudWeeklyValidB
cloudWeeklyActive = cloudWeeklyShow and cloudWeeklyValid and timeframe.isweekly
cloudWeeklyFillColor = color.rgb(0, 0, 0, 100)
if cloudWeeklyActive
    cloudWeeklyFillColor := cloudWeeklyValA < cloudWeeklyValB ? cloudWeeklyDown : cloudWeeklyUp
