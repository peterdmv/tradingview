// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © peterdmv
//
// Independently designed and written from scratch: 20 flat, freely-assignable
// MA slots (each can appear on any combination of Intraday/Daily/Weekly/Monthly
// charts, computed natively — no cross-timeframe fetch, no repainting), plus 5
// dedicated cross-timeframe overlay slots (e.g. weekly MA shown on a daily
// chart) that intentionally do use request.security(), and per-class cloud
// fills with on-chart validation if a cloud's chosen slots aren't both enabled
// for the active timeframe.
//
// Release: v1

//@version=6
indicator(title='MA Slots - Multi-Timeframe', shorttitle='MA Slots', overlay=true)

//***************************************************************************************
// Helper functions
//***************************************************************************************

// MA-type dispatcher, shared by every slot.
f_ma(src, len, maType) =>
    switch maType
        'SMA' => ta.sma(src, len)
        'EMA' => ta.ema(src, len)
        'RMA' => ta.rma(src, len)
        'VWMA' => ta.vwma(src, len)
        => ta.wma(src, len)

// Picks one of 20 slot values by number (1-based), for cloud boundaries.
f_pick(idx, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8, float v9, float v10, float v11, float v12, float v13, float v14, float v15, float v16, float v17, float v18, float v19, float v20) =>
    switch idx
        1 => v1
        2 => v2
        3 => v3
        4 => v4
        5 => v5
        6 => v6
        7 => v7
        8 => v8
        9 => v9
        10 => v10
        11 => v11
        12 => v12
        13 => v13
        14 => v14
        15 => v15
        16 => v16
        17 => v17
        18 => v18
        19 => v19
        => v20

// Picks one of 20 slot enable-checkboxes by number, to validate a cloud's
// chosen pair is actually enabled for the timeframe class being checked.
f_pickBool(idx, bool v1, bool v2, bool v3, bool v4, bool v5, bool v6, bool v7, bool v8, bool v9, bool v10, bool v11, bool v12, bool v13, bool v14, bool v15, bool v16, bool v17, bool v18, bool v19, bool v20) =>
    switch idx
        1 => v1
        2 => v2
        3 => v3
        4 => v4
        5 => v5
        6 => v6
        7 => v7
        8 => v8
        9 => v9
        10 => v10
        11 => v11
        12 => v12
        13 => v13
        14 => v14
        15 => v15
        16 => v16
        17 => v17
        18 => v18
        19 => v19
        => v20

//***************************************************************************************
// Inputs — Native Slots
// Each slot is computed on the chart's own bars (no cross-timeframe fetch, no
// repainting) and just needs its relevant timeframe box(es) checked to appear
// there. One slot with both Daily and Weekly checked shows a normal Daily-native
// line while viewing a daily chart, and a normal Weekly-native line while
// viewing a weekly chart — never both at once, no stepping.
//***************************************************************************************

s1Len = input.int(title='Period', minval=1, maxval=5000, defval=4, inline='S1a', group='Slot 1', display=display.data_window)
s1Type = input.string(title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], defval='EMA', inline='S1a', group='Slot 1', display=display.data_window)
s1Src = input.source(title='', defval=close, inline='S1a', group='Slot 1', display=display.data_window)
s1Col = input.color(title='', defval=color.silver, inline='S1a', group='Slot 1', display=display.data_window)
s1Width = input.int(title='Width', minval=1, maxval=4, defval=1, inline='S1a', group='Slot 1', display=display.data_window)
s1Intra = input.bool(title='Intraday', defval=false, inline='S1b', group='Slot 1', display=display.data_window)
s1Daily = input.bool(title='Daily', defval=true, inline='S1b', group='Slot 1', display=display.data_window)
s1Weekly = input.bool(title='Weekly', defval=false, inline='S1b', group='Slot 1', display=display.data_window)
s1Monthly = input.bool(title='Monthly', defval=false, inline='S1b', group='Slot 1', display=display.data_window)

