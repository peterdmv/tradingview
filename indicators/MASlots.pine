s20Show = (timeframe.isintraday and s20Intra) or (timeframe.isdaily and s20Daily) or (timeframe.isweekly and s20Weekly) or (timeframe.ismonthly and s20Monthly)
s20Plot = plot(s20Show ? s20Val : na, title='Slot 20', color=s20Col, linewidth=s20Width)

//***************************************************************************************
// Calculate & plot — Cross-Timeframe Overlays
//***************************************************************************************

o1Val = request.security(syminfo.tickerid, o1SrcTF, f_ma(o1Src, o1Len, o1Type), lookahead=barmerge.lookahead_on)
o1Show = (timeframe.isintraday and o1DispIntra) or (timeframe.isdaily and o1DispDaily) or (timeframe.isweekly and o1DispWeekly) or (timeframe.ismonthly and o1DispMonthly)
plot(o1Show ? o1Val : na, title='Overlay 1', color=o1Col, linewidth=o1Width)

o2Val = request.security(syminfo.tickerid, o2SrcTF, f_ma(o2Src, o2Len, o2Type), lookahead=barmerge.lookahead_on)
o2Show = (timeframe.isintraday and o2DispIntra) or (timeframe.isdaily and o2DispDaily) or (timeframe.isweekly and o2DispWeekly) or (timeframe.ismonthly and o2DispMonthly)
plot(o2Show ? o2Val : na, title='Overlay 2', color=o2Col, linewidth=o2Width)

o3Val = request.security(syminfo.tickerid, o3SrcTF, f_ma(o3Src, o3Len, o3Type), lookahead=barmerge.lookahead_on)
o3Show = (timeframe.isintraday and o3DispIntra) or (timeframe.isdaily and o3DispDaily) or (timeframe.isweekly and o3DispWeekly) or (timeframe.ismonthly and o3DispMonthly)
plot(o3Show ? o3Val : na, title='Overlay 3', color=o3Col, linewidth=o3Width)

o4Val = request.security(syminfo.tickerid, o4SrcTF, f_ma(o4Src, o4Len, o4Type), lookahead=barmerge.lookahead_on)
o4Show = (timeframe.isintraday and o4DispIntra) or (timeframe.isdaily and o4DispDaily) or (timeframe.isweekly and o4DispWeekly) or (timeframe.ismonthly and o4DispMonthly)
plot(o4Show ? o4Val : na, title='Overlay 4', color=o4Col, linewidth=o4Width)

o5Val = request.security(syminfo.tickerid, o5SrcTF, f_ma(o5Src, o5Len, o5Type), lookahead=barmerge.lookahead_on)
o5Show = (timeframe.isintraday and o5DispIntra) or (timeframe.isdaily and o5DispDaily) or (timeframe.isweekly and o5DispWeekly) or (timeframe.ismonthly and o5DispMonthly)
plot(o5Show ? o5Val : na, title='Overlay 5', color=o5Col, linewidth=o5Width)

//***************************************************************************************
// Calculate & plot — VWAP
//***************************************************************************************

vwapVal = ta.vwap(vwapSrc)
plot(vwapShow and timeframe.isintraday ? vwapVal : na, title='VWAP', color=vwapCol, linewidth=vwapWidth)

//***************************************************************************************
// Calculate & plot — Clouds
// Each cloud only ever matters while viewing its own class's chart (a chart is
// always exactly one class), so it's gated to that class and validated against
// that class's own checkboxes for the two chosen slots.
//***************************************************************************************

// Intraday cloud
cloudIntradayValA = f_pick(cloudIntradayMA1, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudIntradayValB = f_pick(cloudIntradayMA2, s1Val, s2Val, s3Val, s4Val, s5Val, s6Val, s7Val, s8Val, s9Val, s10Val, s11Val, s12Val, s13Val, s14Val, s15Val, s16Val, s17Val, s18Val, s19Val, s20Val)
cloudIntradayValidA = f_pickBool(cloudIntradayMA1, s1Intra, s2Intra, s3Intra, s4Intra, s5Intra, s6Intra, s7Intra, s8Intra, s9Intra, s10Intra, s11Intra, s12Intra, s13Intra, s14Intra, s15Intra, s16Intra, s17Intra, s18Intra, s19Intra, s20Intra)
