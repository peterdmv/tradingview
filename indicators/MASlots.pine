s5Plot = plot(s5Show ? s5Val : na, title='Slot 5', color=s5Col, linewidth=s5Width)

s6Val = f_ma(s6Src, s6Len, s6Type)
s6Show = (timeframe.isintraday and s6Intra) or (timeframe.isdaily and s6Daily) or (timeframe.isweekly and s6Weekly) or (timeframe.ismonthly and s6Monthly)
s6Plot = plot(s6Show ? s6Val : na, title='Slot 6', color=s6Col, linewidth=s6Width)

s7Val = f_ma(s7Src, s7Len, s7Type)
