s8Plot = plot(s8Show ? s8Val : na, title='Slot 8', color=s8Col, linewidth=s8Width)

s9Val = f_ma(s9Src, s9Len, s9Type)
s9Show = (timeframe.isintraday and s9Intra) or (timeframe.isdaily and s9Daily) or (timeframe.isweekly and s9Weekly) or (timeframe.ismonthly and s9Monthly)
s9Plot = plot(s9Show ? s9Val : na, title='Slot 9', color=s9Col, linewidth=s9Width)

s10Val = f_ma(s10Src, s10Len, s10Type)
s10Show = (timeframe.isintraday and s10Intra) or (timeframe.isdaily and s10Daily) or (timeframe.isweekly and s10Weekly) or (timeframe.ismonthly and s10Monthly)
s10Plot = plot(s10Show ? s10Val : na, title='Slot 10', color=s10Col, linewidth=s10Width)

s11Val = f_ma(s11Src, s11Len, s11Type)
s11Show = (timeframe.isintraday and s11Intra) or (timeframe.isdaily and s11Daily) or (timeframe.isweekly and s11Weekly) or (timeframe.ismonthly and s11Monthly)
s11Plot = plot(s11Show ? s11Val : na, title='Slot 11', color=s11Col, linewidth=s11Width)

s12Val = f_ma(s12Src, s12Len, s12Type)
s12Show = (timeframe.isintraday and s12Intra) or (timeframe.isdaily and s12Daily) or (timeframe.isweekly and s12Weekly) or (timeframe.ismonthly and s12Monthly)
s12Plot = plot(s12Show ? s12Val : na, title='Slot 12', color=s12Col, linewidth=s12Width)

