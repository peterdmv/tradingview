    cloudMonthlyFillColor := cloudMonthlyValA < cloudMonthlyValB ? cloudMonthlyDown : cloudMonthlyUp
cloudMonthlyPlotA = plot(cloudMonthlyActive ? cloudMonthlyValA : na, title='Monthly Cloud Boundary A', display=display.none)
cloudMonthlyPlotB = plot(cloudMonthlyActive ? cloudMonthlyValB : na, title='Monthly Cloud Boundary B', display=display.none)
fill(cloudMonthlyPlotA, cloudMonthlyPlotB, color=cloudMonthlyFillColor)
cloudMonthlyInvalid = cloudMonthlyShow and timeframe.ismonthly and not cloudMonthlyValid

//***************************************************************************************
// Validation warning — tells you when a cloud can't draw because one or both
// of its chosen slots aren't enabled for the timeframe you're viewing.
//***************************************************************************************

warnMsg = cloudIntradayInvalid ? "Intraday Cloud: one or both selected slots aren't enabled for Intraday" : cloudDailyInvalid ? "Daily Cloud: one or both selected slots aren't enabled for Daily" : cloudWeeklyInvalid ? "Weekly Cloud: one or both selected slots aren't enabled for Weekly" : cloudMonthlyInvalid ? "Monthly Cloud: one or both selected slots aren't enabled for Monthly" : ""

var label warnLbl = na
if barstate.islast
    label.delete(warnLbl)
    if warnMsg != ""
        warnLbl := label.new(bar_index, high, warnMsg, style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
    else
        warnLbl := na
