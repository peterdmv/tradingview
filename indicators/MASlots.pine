s16Show = (timeframe.isintraday and s16Intra) or (timeframe.isdaily and s16Daily) or (timeframe.isweekly and s16Weekly) or (timeframe.ismonthly and s16Monthly)
s16Plot = plot(s16Show ? s16Val : na, title='Slot 16', color=s16Col, linewidth=s16Width)

s17Val = f_ma(s17Src, s17Len, s17Type)
s17Show = (timeframe.isintraday and s17Intra) or (timeframe.isdaily and s17Daily) or (timeframe.isweekly and s17Weekly) or (timeframe.ismonthly and s17Monthly)
s17Plot = plot(s17Show ? s17Val : na, title='Slot 17', color=s17Col, linewidth=s17Width)

s18Val = f_ma(s18Src, s18Len, s18Type)
s18Show = (timeframe.isintraday and s18Intra) or (timeframe.isdaily and s18Daily) or (timeframe.isweekly and s18Weekly) or (timeframe.ismonthly and s18Monthly)
s18Plot = plot(s18Show ? s18Val : na, title='Slot 18', color=s18Col, linewidth=s18Width)

s19Val = f_ma(s19Src, s19Len, s19Type)
s19Show = (timeframe.isintraday and s19Intra) or (timeframe.isdaily and s19Daily) or (timeframe.isweekly and s19Weekly) or (timeframe.ismonthly and s19Monthly)
