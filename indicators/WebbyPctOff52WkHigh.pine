//
// Recreation of Webby's ATR Off 52-Week High indicator (Mike Webster, IBD/O'Neil). Reimplemented for educational purposes.
//
// Release: v1

//@version=6
indicator("Webby's ATR Off 52-Week High", shorttitle="ATR Off 52W", overlay=false)

high52   = ta.highest(high, 252)
atr_off  = -math.min((high52 - low) / ta.atr(50), 12)

line_color = atr_off >= -4 ? color.green : atr_off >= -8 ? color.yellow : color.red

plot(atr_off, title="ATR Off 52W High", color=line_color, linewidth=2)

hline(0,   "52W High",          color=color.new(color.gray, 60), linestyle=hline.style_dotted)
hline(-4,  "Green Zone Floor",  color=color.green,               linestyle=hline.style_dashed)
hline(-8,  "Yellow Zone Floor", color=color.yellow,              linestyle=hline.style_dashed)
hline(-12, "Red Zone Floor",    color=color.red,                 linestyle=hline.style_dashed)
