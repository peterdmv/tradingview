iIntraMA2Source = input.source(title='', defval=close, inline='I2', group='Intraday Moving Averages', display=display.data_window)
iIntraMA2Color = input.color(title='', defval=color.purple, inline='I2', group='Intraday Moving Averages', display=display.data_window)
iIntraMA2Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I2', group='Intraday Moving Averages', display=display.data_window)

