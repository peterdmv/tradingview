iIntraMA5Color = input.color(title='', defval=color.gray, inline='I5', group='Intraday Moving Averages', display=display.data_window)
iIntraMA5Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I5', group='Intraday Moving Averages', display=display.data_window)

iIntraCloud = input.bool(title='Show Moving Average Cloud', defval=false, inline='I6', display=display.data_window, tooltip='Fill area between the first two defined ' +
     'moving averages with color. At a glance, you can see if the slower moving average is above or below the faster moving average.')
iIntraCloudColorUp = input.color(title='   Up', defval=color.new(color.green, transp=90), inline='I6', display=display.data_window)
iIntraCloudColorDown = input.color(title='Down', defval=color.new(color.red, transp=90), inline='I6', display=display.data_window)

iIntraVWAPVisible = input.bool(title='', defval=true, inline='I7', group='Intraday Indicators', display=display.data_window)
iIntraVWAPSource = input.source(title='', defval=hlc3, inline='I7', group='Intraday Indicators', display=display.data_window)
iIntraVWAPColor = input.color(title='', defval=color.orange, inline='I7', group='Intraday Indicators', display=display.data_window)
iIntraVWAPWidth = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I7', group='Intraday Indicators', display=display.data_window)


