iDailyCloud = input.bool(title='Show Moving Average Cloud', defval=false, inline='I14', display=display.data_window, tooltip='Fill area between the first two defined ' +
     'moving averages with color. At a glance, you can see if the slower moving average is above or below the faster moving average.')
iDailyCloudColorUp = input.color(title='   Up', defval=color.new(color.green, transp=90), inline='I14', display=display.data_window)
iDailyCloudColorDown = input.color(title='Down', defval=color.new(color.red, transp=90), inline='I14', display=display.data_window)

iWeeklyOnDaily = input.bool(title='Show Weekly on Daily', defval=false, inline='I14', display=display.data_window)
iWeeklyOnDailyColor = input.color(title='', defval=color.olive, inline='I14', display=display.data_window)
iWeeklyOnDailyWidth = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I14', display=display.data_window)


