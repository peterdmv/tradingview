iIntraMA3Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I3', group='Intraday Moving Averages', display=display.data_window)

iIntraMA4Visible = input.bool(title='', defval=true, inline='I4', group='Intraday Moving Averages', display=display.data_window)
