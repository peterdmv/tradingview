iWeeklyMA1Color = input.color(title='', defval=color.lime, inline='I14', group='Weekly Moving Averages', display=display.data_window)
iWeeklyMA1Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I14', group='Weekly Moving Averages', display=display.data_window)

