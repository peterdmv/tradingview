iMonthlyMA1Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I19w', group='Monthly Moving Averages', display=display.data_window)

iMonthlyMA2Visible = input.bool(title='', defval=true, inline='I20', group='Monthly Moving Averages', display=display.data_window)
