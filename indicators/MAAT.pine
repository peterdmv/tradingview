//@version=6
indicator('Moving Averages For All Timeframes', shorttitle='MAAT', overlay=true)

//***************************************************************************************
// Inputs
//***************************************************************************************

//---------------------------------------------------
// Intraday
//---------------------------------------------------
iIntraMA1Visible = input.bool(title='', defval=true, inline='I1', group='Intraday Moving Averages', display=display.data_window)
iIntraMA1Length = input.int(title='Period', minval=1, maxval=5000, defval=8, inline='I1', group='Intraday Moving Averages', display=display.data_window)
iIntraMA1Type = input.string(title='', options=['SMA', 'EMA', 'RMA', 'VWMA', 'WMA'], defval='EMA', inline='I1', group='Intraday Moving Averages', display=display.data_window)
iIntraMA1Source = input.source(title='', defval=close, inline='I1', group='Intraday Moving Averages', display=display.data_window)
iIntraMA1Color = input.color(title='', defval=color.green, inline='I1', group='Intraday Moving Averages', display=display.data_window)
iIntraMA1Width = input.int(title='Width', defval=1, minval=1, maxval=4, inline='I1', group='Intraday Moving Averages', display=display.data_window)

