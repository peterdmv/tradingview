     'moving averages with color. At a glance, you can see if the slower moving average is above or below the faster moving average.')
iMonthlyCloudColorUp = input.color(title='   Up', defval=color.new(color.green, transp=90), inline='I23', display=display.data_window)
iMonthlyCloudColorDown = input.color(title='Down', defval=color.new(color.red, transp=90), inline='I23', display=display.data_window)

//***************************************************************************************
// Helper functions
//***************************************************************************************

// Single shared MA-type dispatcher, used by every MA slot below instead of
// repeating a type-selector chain per slot.
f_ma(src, len, maType) =>
    switch maType
        'SMA' => ta.sma(src, len)
        'EMA' => ta.ema(src, len)
        'RMA' => ta.rma(src, len)
        'VWMA' => ta.vwma(src, len)
        => ta.wma(src, len)

//***************************************************************************************
// Plot moving averages
//***************************************************************************************

//---------------------------------------------------
// Intraday
//---------------------------------------------------
intraMA1 = 0.0
intraMA2 = 0.0
intraMA3 = 0.0
intraMA4 = 0.0
intraMA5 = 0.0
intraVWAP = 0.0
if (timeframe.isintraday)
    intraMA1 := f_ma(iIntraMA1Source, iIntraMA1Length, iIntraMA1Type)
    intraMA2 := f_ma(iIntraMA2Source, iIntraMA2Length, iIntraMA2Type)
    intraMA3 := f_ma(iIntraMA3Source, iIntraMA3Length, iIntraMA3Type)
    intraMA4 := f_ma(iIntraMA4Source, iIntraMA4Length, iIntraMA4Type)
    intraMA5 := f_ma(iIntraMA5Source, iIntraMA5Length, iIntraMA5Type)
    intraVWAP := ta.vwap(iIntraVWAPSource)

i1 = plot(iIntraMA1Visible and timeframe.isintraday ? intraMA1 : na, title='Intraday Moving Average #1', color=iIntraMA1Color, linewidth=iIntraMA1Width)
i2 = plot(iIntraMA2Visible and timeframe.isintraday ? intraMA2 : na, title='Intraday Moving Average #2', color=iIntraMA2Color, linewidth=iIntraMA2Width)
plot(iIntraMA3Visible and timeframe.isintraday ? intraMA3 : na, title='Intraday Moving Average #3', color=iIntraMA3Color, linewidth=iIntraMA3Width)
plot(iIntraMA4Visible and timeframe.isintraday ? intraMA4 : na, title='Intraday Moving Average #4', color=iIntraMA4Color, linewidth=iIntraMA4Width)
plot(iIntraMA5Visible and timeframe.isintraday ? intraMA5 : na, title='Intraday Moving Average #5', color=iIntraMA5Color, linewidth=iIntraMA5Width)

// Show moving average cloud
fillColor = color.rgb(0, 0, 0, 100)  // Transparent
if (iIntraCloud)
    fillColor := intraMA1 < intraMA2 ? iIntraCloudColorDown : iIntraCloudColorUp
fill(i1, i2, color=fillColor)

plot(iIntraVWAPVisible and timeframe.isintraday ? intraVWAP : na, title='Intraday Volume Weighted Average Price', color=iIntraVWAPColor, linewidth=iIntraVWAPWidth)

//---------------------------------------------------
// Daily
//---------------------------------------------------
dailyMA1 = 0.0
dailyMA2 = 0.0
dailyMA3 = 0.0
dailyMA4 = 0.0
dailyMA5 = 0.0
dailyMA6 = 0.0
dailyMA7 = 0.0
if (timeframe.isdaily)
    dailyMA1 := f_ma(iDailyMA1Source, iDailyMA1Length, iDailyMA1Type)
    dailyMA2 := f_ma(iDailyMA2Source, iDailyMA2Length, iDailyMA2Type)
    dailyMA3 := f_ma(iDailyMA3Source, iDailyMA3Length, iDailyMA3Type)
    dailyMA4 := f_ma(iDailyMA4Source, iDailyMA4Length, iDailyMA4Type)
    dailyMA5 := f_ma(iDailyMA5Source, iDailyMA5Length, iDailyMA5Type)
    dailyMA6 := f_ma(iDailyMA6Source, iDailyMA6Length, iDailyMA6Type)
    dailyMA7 := f_ma(iDailyMA7Source, iDailyMA7Length, iDailyMA7Type)

d1 = plot(iDailyMA1Visible and timeframe.isdaily ? dailyMA1 : na, title='Daily Moving Average #1', color=iDailyMA1Color, linewidth=iDailyMA1Width)
d2 = plot(iDailyMA2Visible and timeframe.isdaily ? dailyMA2 : na, title='Daily Moving Average #2', color=iDailyMA2Color, linewidth=iDailyMA2Width)
plot(iDailyMA3Visible and timeframe.isdaily ? dailyMA3 : na, title='Daily Moving Average #3', color=iDailyMA3Color, linewidth=iDailyMA3Width)
plot(iDailyMA4Visible and timeframe.isdaily ? dailyMA4 : na, title='Daily Moving Average #4', color=iDailyMA4Color, linewidth=iDailyMA4Width)
plot(iDailyMA5Visible and timeframe.isdaily ? dailyMA5 : na, title='Daily Moving Average #5', color=iDailyMA5Color, linewidth=iDailyMA5Width)
plot(iDailyMA6Visible and timeframe.isdaily ? dailyMA6 : na, title='Daily Moving Average #6', color=iDailyMA6Color, linewidth=iDailyMA6Width)
plot(iDailyMA7Visible and timeframe.isdaily ? dailyMA7 : na, title='Daily Moving Average #6', color=iDailyMA7Color, linewidth=iDailyMA7Width)

// Show weekly on daily
w = request.security(syminfo.tickerid, 'W', f_ma(close, iWeeklyOnDailyLength, iWeeklyOnDailyType), lookahead = barmerge.lookahead_on)
plot(iWeeklyOnDaily and timeframe.isdaily ? w : na, color=iWeeklyOnDailyColor, linewidth=iWeeklyOnDailyWidth)

// Show moving average cloud
fillColor := color.rgb(0, 0, 0, 100)  // Transparent
if (iDailyCloud)
    fillColor := dailyMA1 < dailyMA2 ? iDailyCloudColorDown : iDailyCloudColorUp
fill(d1, d2, color=fillColor)

//---------------------------------------------------
// Weekly
//---------------------------------------------------
weeklyMA1 = 0.0
weeklyMA2 = 0.0
weeklyMA3 = 0.0
weeklyMA4 = 0.0
if timeframe.isweekly
    weeklyMA1 := f_ma(iWeeklyMA1Source, iWeeklyMA1Length, iWeeklyMA1Type)
    weeklyMA2 := f_ma(iWeeklyMA2Source, iWeeklyMA2Length, iWeeklyMA2Type)
    weeklyMA3 := f_ma(iWeeklyMA3Source, iWeeklyMA3Length, iWeeklyMA3Type)
    weeklyMA4 := f_ma(iWeeklyMA4Source, iWeeklyMA4Length, iWeeklyMA4Type)

w1 = plot(iWeeklyMA1Visible and timeframe.isweekly ? weeklyMA1 : na, title='Weekly Moving Average #1', color=iWeeklyMA1Color, linewidth=iWeeklyMA1Width)
w2 = plot(iWeeklyMA2Visible and timeframe.isweekly ? weeklyMA2 : na, title='Weekly Moving Average #2', color=iWeeklyMA2Color, linewidth=iWeeklyMA2Width)
plot(iWeeklyMA3Visible and timeframe.isweekly ? weeklyMA3 : na, title='Weekly Moving Average #3', color=iWeeklyMA3Color, linewidth=iWeeklyMA3Width)
plot(iWeeklyMA4Visible and timeframe.isweekly ? weeklyMA4 : na, title='Weekly Moving Average #4', color=iWeeklyMA4Color, linewidth=iWeeklyMA4Width)

// Show moving average cloud
fillColor := color.rgb(0, 0, 0, 100)  // Transparent
if (iWeeklyCloud)
    fillColor := weeklyMA1 < weeklyMA2 ? iWeeklyCloudColorDown : iWeeklyCloudColorUp
fill(w1, w2, color=fillColor)


//---------------------------------------------------
// Monthly
//---------------------------------------------------
monthlyMA1 = 0.0
monthlyMA2 = 0.0
monthlyMA3 = 0.0
monthlyMA4 = 0.0
if (timeframe.ismonthly)
    monthlyMA1 := f_ma(iMonthlyMA1Source, iMonthlyMA1Length, iMonthlyMA1Type)
    monthlyMA2 := f_ma(iMonthlyMA2Source, iMonthlyMA2Length, iMonthlyMA2Type)
    monthlyMA3 := f_ma(iMonthlyMA3Source, iMonthlyMA3Length, iMonthlyMA3Type)
    monthlyMA4 := f_ma(iMonthlyMA4Source, iMonthlyMA4Length, iMonthlyMA4Type)

m1 = plot(iMonthlyMA1Visible and timeframe.ismonthly ? monthlyMA1 : na, title='Monthly Moving Average #1', color=iMonthlyMA1Color, linewidth=iMonthlyMA1Width)
m2 = plot(iMonthlyMA2Visible and timeframe.ismonthly ? monthlyMA2 : na, title='Monthly Moving Average #2', color=iMonthlyMA2Color, linewidth=iMonthlyMA2Width)
plot(iMonthlyMA3Visible and timeframe.ismonthly ? monthlyMA3 : na, title='Monthly Moving Average #3', color=iMonthlyMA3Color, linewidth=iMonthlyMA3Width)
plot(iMonthlyMA4Visible and timeframe.ismonthly ? monthlyMA4 : na, title='Monthly Moving Average #4', color=iMonthlyMA4Color, linewidth=iMonthlyMA4Width)

// Show moving average cloud
fillColor := color.rgb(0, 0, 0, 100)  // Transparent
if (iMonthlyCloud)
    fillColor := monthlyMA1 < monthlyMA2 ? iMonthlyCloudColorDown : iMonthlyCloudColorUp
fill(m1, m2, color=fillColor)
